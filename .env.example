# Copy to .env (git-ignored). contexto_solver/config.py reads these once at import;
# exported shell variables take precedence over .env values.

# --- Model serving (Ollama) --------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1      # must end in /v1
OLLAMA_MODEL=qwen3:14b                         # study models: qwen3:14b, gemma4:12b, ministral-3:14b
OLLAMA_REQUEST_TIMEOUT_SECONDS=900
LLM_WORKERS=4
# Only for --provider openai / anthropic (not used by the study):
# LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Contexto game service ----------------------------------------------------
# API_BASE_URL=https://api.contexto.me/machado/en/game
# API_RATE_LIMIT=0.5
RANK_CACHE_ENABLED=1
RANK_CACHE_DIR=data/rank_cache
TRACE_DIR=traces

# --- Population (same names in every environment) -----------------------------
# Keep INITIAL_POPULATION == SURVIVORS + SURVIVORS*OFFSPRING_PER_PARENT + CROSSOVER_CHILDREN
# so the selection pool has the same size in every generation (15 = 5 + 10 + 0).
MAX_GENERATIONS=30
INITIAL_POPULATION=15
SURVIVORS=5
OFFSPRING_PER_PARENT=2
CROSSOVER_CHILDREN=0
WORDS_PER_INDIVIDUAL=3
PARENT_REFRESH=0                 # 1 = surviving parents keep proposing words (submitted-study behaviour)
SELECTION=mu_plus_lambda         # mu_plus_lambda | random (selection-response control) | report_rewarded (positive control)
RANDOM_SEED=

# --- Submitted-study reproduction (--method ea_semantic_operators_legacy) ------
LEGACY_SELECTION=tophalf         # tophalf | random

# --- Self-reports ----------------------------------------------------------------
SELF_REPORT=1
RATIONALE_INHERITANCE=1          # Contexto only; the two new environments use RATIONALE_CHANNEL
PERSIST_CALL_LOG=0

# --- Planning and code repair (python -m search.run) -----------------------------
# What fills the rationale slot of every mutation prompt:
#   inherited        the parent's stored basis words and reason (as in Contexto)
#   prospective      a strategy (plans) / diagnosis (code) written by a separate call before the candidate call
#   corrective_hint  one sentence of exact environment feedback (the control)
#   none             empty slot
RATIONALE_CHANNEL=inherited

# --- Offline GloVe comparison only ---------------------------------------------
# GLOVE_PATH=data/glove.6B.300d.txt
